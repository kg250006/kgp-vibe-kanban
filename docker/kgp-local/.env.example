# Prefer generating this file:  .\setup.ps1  (Windows)  /  ./setup.sh  (macOS)
# Copy to .env and edit only if you want to do it by hand.

# --- Windows -----------------------------------------------------------------
# Backslashes are fine; do not quote.
#
#   VK_REPOS_DIR=C:\PROJECTS
#   VK_CLAUDE_DIR=C:\Users\YOURNAME\.claude
#   VK_CLAUDE_JSON=C:\Users\YOURNAME\.claude.json

# --- macOS / Linux -----------------------------------------------------------
# Absolute paths only — Docker Compose does not expand ~ or $HOME here.
#
#   VK_REPOS_DIR=/Users/yourname/Projects
#   VK_CLAUDE_DIR=/Users/yourname/.claude
#   VK_CLAUDE_JSON=/Users/yourname/.claude.json

# Folder containing your git repositories. Mounted at /repos in the container;
# this is the path you browse when adding a project in the UI.
VK_REPOS_DIR=

# Claude Code profile on this machine, mounted read-only and copied in once.
# Point either at ./noseed and ./noseed.json if you have no profile yet —
# Docker creates a *directory* at a bind-mount source that does not exist,
# which would turn ~/.claude.json into a folder.
VK_CLAUDE_DIR=./noseed
VK_CLAUDE_JSON=./noseed.json

# Host ports.
VK_PORT=3000
VK_PREVIEW_PORT=3001

# Commit identity for work the agent does.
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# Usually required on macOS hosts: Claude Code keeps its OAuth token in the
# login Keychain there, so there is no credentials file to seed. On Windows and
# Linux the seeded token normally covers it and this can stay empty.
ANTHROPIC_API_KEY=

# info | debug | trace
RUST_LOG=info

# Any non-empty value keeps worktrees on disk after a workspace is cleaned up.
DISABLE_WORKTREE_CLEANUP=

# Only needed behind a reverse proxy / custom hostname.
VK_ALLOWED_ORIGINS=
